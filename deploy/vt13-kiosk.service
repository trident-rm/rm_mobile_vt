[Unit]
Description=VT13 DJI C5 -> CM311 KMS kiosk
After=systemd-udev-trigger.service
RequiresMountsFor=/home/billieguo/mobile_vt
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=billieguo
Group=billieguo
WorkingDirectory=/home/billieguo/mobile_vt
Environment=VT13_ASYNC_USB=0
ExecStart=/home/billieguo/mobile_vt/.venv-v4l2/bin/python -u -m vt13_video stream --config /home/billieguo/mobile_vt/config/vt13_video.kiosk.yaml --headless
Restart=always
RestartSec=15
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0077
MemoryMax=512M
LogNamespace=vt13-kiosk
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vt13-kiosk

[Install]
WantedBy=multi-user.target
