[Unit]
Description=VT13 DJI C5 -> CM311 KMS kiosk
After=systemd-udev-trigger.service
RequiresMountsFor=/home/billieguo/mobile_vt
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=billieguo
Group=billieguo
WorkingDirectory=/home/billieguo/mobile_vt
Environment=VT13_ASYNC_USB=0
# Display orientation: rotate the KMS overlay 180 degrees for the mounted VT camera.
Environment=VT13_WORKER_ROTATION=180
# Native worker backend: Python handles USB/DUML control and AU delivery only;
# PyAV is not imported on this path. Use the verified system Python closure.
ExecStart=/usr/bin/python3 -u -m vt13_video stream --config /home/billieguo/mobile_vt/config/vt13_video.kiosk.yaml --headless
Restart=always
RestartSec=15
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0077
MemoryMax=512M
LogNamespace=vt13-kiosk
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vt13-kiosk

[Install]
WantedBy=multi-user.target
